# Meridian Oracle Relayer — Environment Configuration

# ── Chain ─────────────────────────────────────────────────────────────────────
CHAIN_ID=amitis-network
RPC_ENDPOINT=https://rpc.amitis.network:443
REST_ENDPOINT=https://rest.amitis.network

# ── Oracle wallet ─────────────────────────────────────────────────────────────
# The wallet that signs SubmitReserve transactions
# This address must be in the ORACLES map of each aggregator contract
ORACLE_MNEMONIC="your twelve or twenty four word mnemonic here"
ORACLE_ADDRESS=amitis1...

# ── Gas ───────────────────────────────────────────────────────────────────────
GAS_PRICE=0.025uamts
GAS_LIMIT=200000
FEE_AMOUNT=150000uamts

# ── Aggregator contracts ──────────────────────────────────────────────────────
# JSON array of aggregator jobs to run
# Each job: { id, aggregator_addr, type, config, cron_schedule }
AGGREGATOR_JOBS='[
  {
    "id": "clssc-usd-fiat",
    "aggregator_addr": "amitis1AGGREGATOR_ADDR_HERE",
    "type": "http_api",
    "label": "CLSSC USD Fiat Reserve",
    "cron_schedule": "0 */6 * * *",
    "config": {
      "url": "https://your-reserve-api.example.com/balance",
      "method": "GET",
      "headers": { "Authorization": "Bearer YOUR_API_TOKEN" },
      "json_path": "balance",
      "decimals": 6
    }
  },
  {
    "id": "acmeusd-tbills",
    "aggregator_addr": "amitis1ANOTHER_AGGREGATOR_HERE",
    "type": "http_api",
    "label": "AcmeUSD T-Bills Reserve",
    "cron_schedule": "0 8 * * *",
    "config": {
      "url": "https://custodian.example.com/api/v1/holdings",
      "method": "GET",
      "headers": { "X-API-Key": "CUSTODIAN_API_KEY" },
      "json_path": "total_value_usd",
      "decimals": 6
    }
  }
]'

# ── Alerting ──────────────────────────────────────────────────────────────────
# Webhook URL for Slack/Discord/PagerDuty alerts
ALERT_WEBHOOK_URL=
# Email for critical alerts
ALERT_EMAIL=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./relayer.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
